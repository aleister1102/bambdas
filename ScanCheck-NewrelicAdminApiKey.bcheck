metadata:
    language: v1-beta
    name: "NewRelic Admin API Key"
    description: "Detects NewRelic Admin API keys in HTTP responses."
    author: "@puzzlepeaches"
    tags: "passive", "newrelic", "api-key", "exposure"

given response then
  if {latest.response} matches "(?i)NRAA-[a-f0-9]{27}" then
      report issue:
          severity: info
          confidence: tentative
          detail: "NewRelic Admin API key found in page."
          remediation: "Review and remove unnecessary exposure of keys and/or sensitive data from page source."
  end if