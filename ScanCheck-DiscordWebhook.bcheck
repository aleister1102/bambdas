metadata:
    language: v1-beta
    name: "Discord Webhook Exposure"
    description: "Detects Discord webhook URLs in HTTP responses."
    author: "@puzzlepeaches"
    tags: "passive", "discord", "webhook", "exposure"

given response then
  if {latest.response} matches "https://discordapp\.com/api/webhooks/[0-9]+/[A-Za-z0-9\-]+" then
     report issue:
       severity: info 
       confidence: tentative
       detail: "Discord Webhook found in page."
       remediation: "Review and remove unnecessary exposure of keys and/or sensitive data from page source."
  end if
