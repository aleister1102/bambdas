metadata:
    language: v2-beta
    name: "Firebase Instance Detection"
    description: "Detects potentially exposed Firebase instances in HTTP responses."
    author: "Unknown"
    tags: "passive", "firebase", "cloud", "exposure"

given response then
    if {latest.response.body} matches ".*\.firebaseapp\.com.*" then
        report issue:
            severity: low
            confidence: firm
            detail: "Potentially exposed Firebase instance detected in response."
            remediation: "Review the Firebase instance to ensure it does not allow unautohrized users to read/write to database."
    end if
