metadata:
    language: v1-beta
    name: "Git Configuration Discovery"
    description: "Detects exposed .git/config files that may reveal repository information."
    author: "github.com/BuffaloWill"
    tags: "active", "git", "config", "exposure"

run for each:
    potential_path =
        ".git/config",
        ".git/config~"

given request then
    send request called check:
        method: "GET"
        replacing path: `{regex_replace({regex_replace({base.request.url},"^.*?\/.*?\/.*?\/","/")},"([^/]+)$", "")}{potential_path}`

    if "[core]" in {check.response.body} then
        report issue:
            severity: low
            confidence: tentative
			detail: `Git configuration found at {potential_path}.`
	end if