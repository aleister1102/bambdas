# URL Override Headers 401/403 Bypass Scanner
# Based on techniques from nomore403 and BypassFuzzer
# Author: Combined from devploit/nomore403 and intrudir/BypassFuzzer

metadata:
    language: v2-beta
    name: "URL Override Headers 401/403 Bypass"
    description: "Attempts to bypass 401/403 using URL override headers like X-Original-URL, X-Rewrite-URL"
    author: "Combined (nomore403 + BypassFuzzer)"
    tags: "bypass", "403", "401", "url-override", "active"

define:
    desc = "Potential 401/403 bypass via URL override header"
    reme = "Do not trust URL override headers for access control decisions."

# ============================================================================
# URL Override Header Bypass
# ============================================================================
run for each:
    override_header =
        "X-Original-URL",
        "X-Original-Url",
        "X-Rewrite-URL",
        "X-Rewrite-Url",
        "X-Override-URL",
        "X-Override-Url",
        "X-Proxy-URL",
        "X-Proxy-Url",
        "X-HTTP-DestinationURL",
        "X-Http-Destinationurl",
        "Request-Uri",
        "X-Request-Uri",
        "Uri",
        "Url",
        "Path",
        "Destination",
        "Redirect",
        "Referer",
        "X-Referrer",
        "Content-Location"

given request then
    if {base.response.status_code} matches "(401|403)" then
        # Test with root path
        send request:
            path: "/"
            replacing headers:
                {override_header}: {base.request.url.path}

        if {latest.response.status_code} matches "^[23]" then
            report issue:
                severity: high
                confidence: tentative
                detail: `{desc}. Header: {override_header} with value: {base.request.url.path}. Original status: {base.response.status_code}, Bypass status: {latest.response.status_code}`
                remediation: {reme}
        end if
    end if
