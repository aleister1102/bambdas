id: 2ffec23a-5012-44fb-9b41-cd453218f88a
name: Add Quote to All Params
function: CUSTOM_ACTION
location: REPEATER
source: |+
  /**
   * Iterates through query, body, multipart, and JSON parameters and adds a single quote
   * to each one incrementally, sending a request for each modification.
   * 
   * Useful for SQL injection testing.
   *
   * @author insomnia1102
   **/
  
  var request = requestResponse.request();
  var httpVersion = request.httpVersion().equals("HTTP/2") ? HttpMode.HTTP_2 : HttpMode.HTTP_1;
  
  var allParams = request.parameters();
  var paramsToTest = new java.util.ArrayList();
  
  for (var param : allParams) {
      var type = param.type();
      if (type == HttpParameterType.URL || 
          type == HttpParameterType.BODY || 
          type == HttpParameterType.JSON || 
          type == HttpParameterType.MULTIPART_ATTRIBUTE) {
          paramsToTest.add(param);
      }
  }
  
  logging().logToOutput("[*] Found " + paramsToTest.size() + " parameters to test\n");
  
  int requestCount = 0;
  int total = paramsToTest.size();
  
  for (int i = 0; i < total; i++) {
      var param = (HttpParameter) paramsToTest.get(i);
      String originalValue = param.value();
      String injectedValue = originalValue + "'";
      
      var newParam = HttpParameter.parameter(param.name(), injectedValue, param.type());
      var modifiedRequest = request.withParameter(newParam);
      
      requestCount++;
      
      try {
          var response = api().http().sendRequest(modifiedRequest, httpVersion);
          
          if (response.response() == null) {
              logging().logToOutput(String.format("[%d/%d] %s (%s): \"%s\" -> \"%s\" | NO RESPONSE",
                  requestCount, total, param.name(), param.type().toString(), originalValue, injectedValue));
              continue;
          }
          
          int statusCode = response.response().statusCode();
          int responseLength = response.response().body() == null ? 0 : response.response().body().length();
          
          logging().logToOutput(String.format("[%d/%d] %s (%s): \"%s\" -> \"%s\" | %d | %d bytes",
              requestCount, total, param.name(), param.type().toString(), originalValue, injectedValue, statusCode, responseLength));
          
          // Show error response body for 4xx/5xx
          if (statusCode >= 400 && response.response().body() != null) {
              String body = response.response().bodyToString();
              if (body.length() > 500) body = body.substring(0, 500) + "...";
              logging().logToOutput("    Response: " + body);
          }
              
      } catch (Exception e) {
          logging().logToOutput(String.format("[%d/%d] %s | ERROR: %s",
              requestCount, total, param.name(), e.getMessage()));
      }
  }
  
  logging().logToOutput("\n[*] Completed: " + requestCount + " tests");
