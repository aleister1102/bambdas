id: c5d6e7f8-e9f0-4ba2-b3c4-d5e6f7a8b9c0
name: Form Params to XML
function: CUSTOM_ACTION
location: REPEATER
source: |+
  /**
   * Converts URL-encoded form parameters to XML format.
   * Updates Content-Type header to application/xml.
   *
   * @author assistant
   **/

  var request = requestResponse.request();

  if (request.body() == null || request.body().length() == 0) {
      logging().logToOutput("[!] No request body found");
      return;
  }

  String bodyStr = request.bodyToString().trim();
  String contentType = "";
  var ctHeader = request.header("Content-Type");
  if (ctHeader != null) {
      contentType = ctHeader.value();
  }

  if (!contentType.contains("application/x-www-form-urlencoded") && !bodyStr.contains("=")) {
      logging().logToOutput("[!] Request body does not appear to be form-urlencoded");
      return;
  }

  String escapeXml(String s) {
      return s.replace("&", "&amp;")
              .replace("<", "&lt;")
              .replace(">", "&gt;")
              .replace("\"", "&quot;")
              .replace("'", "&apos;");
  }

  try {
      StringBuilder xml = new StringBuilder();
      xml.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
      xml.append("<root>\n");

      String[] params = bodyStr.split("&");

      for (String param : params) {
          if (param.isEmpty()) continue;

          int eqIndex = param.indexOf("=");
          String key, value;

          if (eqIndex > 0) {
              key = param.substring(0, eqIndex);
              value = param.substring(eqIndex + 1);
          } else if (eqIndex == 0) {
              continue;
          } else {
              key = param;
              value = "";
          }

          // URL decode
          key = utilities().urlUtils().decode(key);
          value = utilities().urlUtils().decode(value);

          // Sanitize key for XML tag name
          String tagName = key.replaceAll("[^a-zA-Z0-9_]", "_");
          if (tagName.matches("^[0-9].*")) {
              tagName = "_" + tagName;
          }

          xml.append("  <").append(tagName).append(">");
          xml.append(escapeXml(value));
          xml.append("</").append(tagName).append(">\n");
      }

      xml.append("</root>");

      request = request.withBody(xml.toString());
      request = request.withUpdatedHeader("Content-Type", "application/xml");
      httpEditor.requestPane().set(request.toByteArray());
      logging().logToOutput("[+] Converted form params to XML");
  } catch (Exception e) {
      logging().logToError("[!] Failed to convert: " + e.getMessage());
  }

