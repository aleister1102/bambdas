id: c3d4e5f6-c7d8-49e0-f1a2-b3c4d5e6f7a8
name: Form Params to JSON
function: CUSTOM_ACTION
location: REPEATER
source: |
  /**
   * Converts URL-encoded form parameters to JSON format.
   * Updates Content-Type header to application/json.
   *
   * @author assistant
   **/

  var request = requestResponse.request();

  if (request.body() == null || request.body().length() == 0) {
      logging().logToOutput("[!] No request body found");
      return;
  }

  String bodyStr = request.bodyToString().trim();
  String contentType = "";
  var ctHeader = request.header("Content-Type");
  if (ctHeader != null) {
      contentType = ctHeader.value();
  }

  if (!contentType.contains("application/x-www-form-urlencoded") && !bodyStr.contains("=")) {
      logging().logToOutput("[!] Request body does not appear to be form-urlencoded");
      return;
  }

  java.util.function.UnaryOperator<String> escapeJson = (s) -> {
      return s.replace("\\", "\\\\")
              .replace("\"", "\\\"")
              .replace("\n", "\\n")
              .replace("\r", "\\r")
              .replace("\t", "\\t");
  };

  try {
      StringBuilder json = new StringBuilder();
      json.append("{");

      String[] params = bodyStr.split("&");
      boolean first = true;

      for (String param : params) {
          if (param.isEmpty()) continue;

          int eqIndex = param.indexOf("=");
          String key, value;

          if (eqIndex > 0) {
              key = param.substring(0, eqIndex);
              value = param.substring(eqIndex + 1);
          } else if (eqIndex == 0) {
              continue; // Skip malformed params
          } else {
              key = param;
              value = "";
          }

          // URL decode
          key = utilities().urlUtils().decode(key);
          value = utilities().urlUtils().decode(value);

          if (!first) {
              json.append(",");
          }
          first = false;

          json.append("\"").append(escapeJson.apply(key)).append("\":");

          // Try to detect if value is a number or boolean
          if (value.isEmpty()) {
              json.append("\"\"");
          } else if (value.equals("true") || value.equals("false")) {
              json.append(value);
          } else if (value.matches("-?\\d+(\\.\\d+)?")) {
              json.append(value);
          } else {
              json.append("\"").append(escapeJson.apply(value)).append("\"");
          }
      }

      json.append("}");

      request = request.withBody(json.toString());
      request = request.withUpdatedHeader("Content-Type", "application/json");
      httpEditor.requestPane().set(request.toByteArray());
      logging().logToOutput("[+] Converted form params to JSON");
  } catch (Exception e) {
      logging().logToError("[!] Failed to convert: " + e.getMessage());
  }
