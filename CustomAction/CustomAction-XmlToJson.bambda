id: c2d3e4f5-b6c7-48d9-e0f1-a2b3c4d5e6f7
name: XML to JSON
function: CUSTOM_ACTION
location: REPEATER
source: |+
  /**
   * Converts XML request body to JSON format.
   * Updates Content-Type header to application/json.
   *
   * @author assistant
   **/

  var request = requestResponse.request();

  if (request.body() == null || request.body().length() == 0) {
      logging().logToOutput("[!] No request body found");
      return;
  }

  String bodyStr = request.bodyToString().trim();

  if (!bodyStr.startsWith("<")) {
      logging().logToOutput("[!] Request body is not XML");
      return;
  }

  // Simple XML to JSON converter
  java.util.function.Function<String, String> xmlToJson = (xml) -> {
      // Remove XML declaration
      xml = xml.replaceAll("<\\?xml[^?]*\\?>", "").trim();

      StringBuilder json = new StringBuilder();
      java.util.Stack<String> tagStack = new java.util.Stack<>();
      java.util.Stack<Boolean> isArrayStack = new java.util.Stack<>();
      java.util.Stack<Boolean> firstChildStack = new java.util.Stack<>();

      int i = 0;
      while (i < xml.length()) {
          // Skip whitespace
          while (i < xml.length() && Character.isWhitespace(xml.charAt(i))) {
              i++;
          }
          if (i >= xml.length()) break;

          if (xml.charAt(i) == '<') {
              // Check for closing tag
              if (i + 1 < xml.length() && xml.charAt(i + 1) == '/') {
                  int tagEnd = xml.indexOf('>', i);
                  if (tagEnd != -1) {
                      if (!tagStack.isEmpty()) {
                          tagStack.pop();
                          if (!isArrayStack.isEmpty()) isArrayStack.pop();
                          if (!firstChildStack.isEmpty()) firstChildStack.pop();
                      }
                      json.append("}");
                      i = tagEnd + 1;
                      continue;
                  }
              }

              // Opening tag
              int tagEnd = xml.indexOf('>', i);
              if (tagEnd != -1) {
                  String tagContent = xml.substring(i + 1, tagEnd);
                  boolean selfClosing = tagContent.endsWith("/");
                  if (selfClosing) {
                      tagContent = tagContent.substring(0, tagContent.length() - 1).trim();
                  }

                  // Extract tag name (ignore attributes for simplicity)
                  String tagName = tagContent.split("\\s+")[0];

                  if (!firstChildStack.isEmpty() && !firstChildStack.peek()) {
                      json.append(",");
                  }
                  if (!firstChildStack.isEmpty()) {
                      firstChildStack.pop();
                      firstChildStack.push(false);
                  }

                  json.append("\"").append(tagName).append("\":");

                  // Check if next content is text or another tag
                  int nextTagStart = xml.indexOf('<', tagEnd + 1);
                  String textContent = "";
                  if (nextTagStart > tagEnd + 1) {
                      textContent = xml.substring(tagEnd + 1, nextTagStart).trim();
                  }

                  if (!textContent.isEmpty() && (nextTagStart == -1 || xml.charAt(nextTagStart + 1) == '/')) {
                      // Text content
                      json.append("\"").append(escapeJson(textContent)).append("\"");
                      i = tagEnd + 1;
                  } else if (selfClosing) {
                      json.append("null");
                      i = tagEnd + 1;
                  } else {
                      json.append("{");
                      tagStack.push(tagName);
                      isArrayStack.push(false);
                      firstChildStack.push(true);
                      i = tagEnd + 1;
                  }
                  continue;
              }
          }
          i++;
      }

      // Wrap in root object if needed
      String result = json.toString();
      if (!result.startsWith("{")) {
          result = "{" + result + "}";
      }
      return result;
  };

  String escapeJson(String s) {
      return s.replace("\\", "\\\\")
              .replace("\"", "\\\"")
              .replace("\n", "\\n")
              .replace("\r", "\\r")
              .replace("\t", "\\t");
  }

  try {
      String jsonBody = xmlToJson.apply(bodyStr);
      request = request.withBody(jsonBody);
      request = request.withUpdatedHeader("Content-Type", "application/json");
      httpEditor.requestPane().set(request.toByteArray());
      logging().logToOutput("[+] Converted XML to JSON");
  } catch (Exception e) {
      logging().logToError("[!] Failed to convert: " + e.getMessage());
  }

