metadata:
    language: v1-beta
    name: "Exposed Prometheus Metrics"
    description: "Detects exposed Prometheus metrics endpoint at /metrics."
    author: "Sourav Kalal"
    tags: "active", "prometheus", "metrics", "exposure"

define:
    potential_path = "/metrics"

given host then
    send request called check:
        method: "GET"
        path: {potential_path}

    if {check.response.status_code} is "200" and "memory" in {check.response.body} then
        report issue:
            severity: low
            confidence: certain
            detail: `Prometheus Metrics found at {potential_path}.`
            remediation: "Ensure your Prometheus Metrics is not exposed."
    end if
