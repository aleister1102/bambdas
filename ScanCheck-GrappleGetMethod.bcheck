metadata:
    language: v2-beta
    name: "GraphQL GET Method Enabled"
    description: "Detects GraphQL endpoints accepting GET requests which may be vulnerable to CSRF attacks."
    author: "Dolev Farhi"
    tags: "active", "graphql", "csrf", "get-method"

run for each:
    potential_path =
         "/graphql?query={__typename}",
         "/api/graphql?query={__typename}"

given host then
    send request called check:
        method: "GET"
        path: {potential_path}

    if "query" in {check.response.body} and "data" in {check.response.body} and "__typename" in {check.response.body} and "application/json" in {check.response.headers} then
        report issue:
            severity: info
            confidence: certain
            detail: `GraphQL CSRF GET Method enabled on {potential_path}.`
            remediation: "Disable GET Method"
    end if
