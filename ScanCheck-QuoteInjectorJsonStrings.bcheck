metadata:
    language: v2-beta
    name: "JSON Quote Injector"
    description: "Active scan check that injects a single quote into JSON string values found in query parameters to test for SQL injection or errors."
    tags: "active", "json", "sqli", "injection"

define:
    injected_query = `{regex_replace({base.request.url.query}, "(:|%3A)\s*(\"|%22)(.*?)(\"|%22)", "$1$2$3'$4")}`

given request then
    # Inject into "key":"value" patterns in the query string (both raw and URL-encoded)
    # We inject a single quote ' at the end of the value
    
    if {base.request.url.query} matches "(:|%3A)\s*(\"|%22)" then
        send request called attack:
            replacing queries: `{injected_query}`

        # Check for 5xx errors
        if {attack.response.status_code} matches "5.." then
            report issue:
                severity: medium
                confidence: tentative
                detail: "JSON injection triggered a server error."
                remediation: "Review the application's handling of JSON input in query parameters."
        end if

        # Check for SQL error messages in attack response but not in baseline
        if {attack.response.body} matches "(?i)(SQL|syntax|ORA-|mysql|postgresql|sqlite|SQLSTATE|Query failed|exception|error)" then
            if not({base.response.body} matches "(?i)(SQL|syntax|ORA-|mysql|postgresql|sqlite|SQLSTATE|Query failed|exception|error)") then
                report issue:
                    severity: medium
                    confidence: tentative
                    detail: "JSON injection triggered an SQL-related error message."
                    remediation: "Review the application's handling of JSON input in query parameters."
            end if
        end if
    end if
