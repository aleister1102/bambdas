id: 7c24dfcf-a424-43f7-b7ac-55795b6f51e2
name: HTTP to HTTPS Redirect
function: VIEW_FILTER
location: PROXY_HTTP_HISTORY
source: |+
  /**
   * Filter requests that are redirected from HTTP to HTTPS
   * Shows only requests where the original URL was HTTP and redirected to HTTPS
   * @author bambdas
   **/

  if (!requestResponse.hasResponse()) {
      return false;
  }

  var request = requestResponse.request();
  var response = requestResponse.response();
  var statusCode = response.statusCode();

  // Check if it's a redirect status code (301, 302, 303, 307, 308)
  if (statusCode < 300 || statusCode > 308) {
      return false;
  }

  // Check if original request was HTTP (not secure)
  if (request.httpService().secure()) {
      return false;
  }

  // Check if Location header exists and points to HTTPS
  if (!response.hasHeader("Location")) {
      return false;
  }

  var location = response.headerValue("Location");
  return location.toLowerCase().startsWith("https://");
