/**
 * JSON state-changing requests with optional deduplication.
 * TOGGLE: Change ENABLE_DEDUP to false to show all requests.
 **/
final boolean ENABLE_DEDUP = true;  // ← toggle this

HttpRequest req = requestResponse.request();
String method = req.method();

// State-changing methods only
if (!(method.equals("POST") || method.equals("PUT") || method.equals("PATCH") || method.equals("DELETE"))) {
    return false;
}

// Must contain JSON
String body = req.bodyToString();
boolean hasJson =
    (req.headerValue("Content-Type") != null && req.headerValue("Content-Type").toLowerCase().contains("application/json")) ||
    (body != null && (body.trim().startsWith("{") || body.trim().startsWith("["))) ||
    (req.hasParameters() && req.parameters().stream()
        .filter(p -> p.type() == HttpParameterType.URL)
        .anyMatch(p -> {
            String v = p.value();
            return v != null && (v.trim().startsWith("{") || v.trim().startsWith("["));
        }));

if (!hasJson) return false;

// Deduplication logic
if (ENABLE_DEDUP) {
    // Session-aware key with timestamp to allow reset on toggle
    String timestamp = System.getProperty("bambda.session.timestamp");
    if (timestamp == null) {
        timestamp = String.valueOf(System.currentTimeMillis());
        System.setProperty("bambda.session.timestamp", timestamp);
    }
    
    String key = method + " " + req.httpService().host() + req.path();
    String propKey = "bambda.seen." + timestamp + "." + key.hashCode();
    
    if (System.getProperty(propKey) != null) return false;  // duplicate
    System.setProperty(propKey, "1");
} else {
    // Clear the session timestamp when dedup is disabled
    System.clearProperty("bambda.session.timestamp");
}

return true;

