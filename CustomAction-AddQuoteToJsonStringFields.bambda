id: f3c8d2a1-7e4b-4f9c-b8d6-2a1e3f5c7d9b
name: Add Quote to JSON String Fields
function: CUSTOM_ACTION
location: REPEATER
source: |+
  /**
   * Iterates through URL-encoded JSON in query parameters and adds a single quote
   * to each string field one at a time, sending a request for each modification.
   * 
   * Useful for SQL injection testing on JSON-based APIs.
   *
   * @author quan.m.le
   **/
  
  var request = requestResponse.request();
  var httpVersion = request.httpVersion().equals("HTTP/2") ? HttpMode.HTTP_2 : HttpMode.HTTP_1;
  
  // Get the full path with query string
  String fullPath = request.path();
  int queryStart = fullPath.indexOf("?");
  
  if (queryStart == -1) {
      logging().logToOutput("No query parameters found");
      return;
  }
  
  String pathWithoutQuery = fullPath.substring(0, queryStart);
  String queryString = fullPath.substring(queryStart + 1);
  
  // Find URL-encoded JSON in query parameters (supports Hackvertor tags)
  String[] params = queryString.split("&");
  String targetParamName = null;
  String encodedJson = null;
  int targetParamIndex = -1;
  boolean hasHackvertor = false;
  String hackvertorPrefix = "";
  String hackvertorSuffix = "";
  
  for (int i = 0; i < params.length; i++) {
      String param = params[i];
      int eqIndex = param.indexOf("=");
      if (eqIndex > 0) {
          String value = param.substring(eqIndex + 1);
          // Detect URL-encoded JSON or Hackvertor-wrapped JSON
          if (value.startsWith("%7b") || value.startsWith("%7B") || (value.contains("<@") && value.contains("@>"))) {
              targetParamName = param.substring(0, eqIndex);
              encodedJson = value;
              targetParamIndex = i;
              hasHackvertor = value.contains("<@") && value.contains("@>");
              break;
          }
      }
  }
  
  if (encodedJson == null) {
      logging().logToOutput("No URL-encoded JSON found in query parameters");
      return;
  }
  
  // Decode the JSON (Hackvertor: extract inner JSON between tags; leave tags intact for send)
  String decodedJson;
  if (hasHackvertor) {
      int openTagEnd = encodedJson.indexOf(">");
      int closeTagStart = encodedJson.lastIndexOf("</@");
      if (openTagEnd != -1 && closeTagStart != -1 && closeTagStart > openTagEnd) {
          hackvertorPrefix = encodedJson.substring(0, openTagEnd + 1);
          hackvertorSuffix = encodedJson.substring(closeTagStart);
          decodedJson = encodedJson.substring(openTagEnd + 1, closeTagStart);
      } else {
          // Fallback: treat whole value as JSON if tags are malformed
          decodedJson = encodedJson;
      }
  } else {
      decodedJson = utilities().urlUtils().decode(encodedJson);
  }
  
  logging().logToOutput("Original JSON: " + decodedJson);
  logging().logToOutput("-------------------------------------------");
  
  // Find all string values in JSON by looking for ":"value" patterns
  // We'll track positions where we find string values
  var stringPositions = new java.util.ArrayList();
  var fieldNames = new java.util.ArrayList();
  var fieldValues = new java.util.ArrayList();

  // Regex parser to find "key":"value" patterns (string values)
  java.util.regex.Pattern p = java.util.regex.Pattern.compile("\"([^\"]+)\"\\s*:\\s*\"([^\"]*)\"");
  java.util.regex.Matcher m = p.matcher(decodedJson);
  while (m.find()) {
      int valueStart = m.start(2);
      int valueEnd = m.end(2);
      String keyName = m.group(1);
      String fieldValue = m.group(2);
      stringPositions.add(new int[]{valueStart, valueEnd});
      fieldNames.add(keyName);
      fieldValues.add(fieldValue);
  }
  
  // Also find strings in arrays like ["value1","value2"]
  int pos = 0;
  while (pos < decodedJson.length()) {
      int bracketStart = decodedJson.indexOf("[\"", pos);
      if (bracketStart == -1) {
          // Also check for comma-separated strings in arrays
          int commaQuote = decodedJson.indexOf(",\"", pos);
          if (commaQuote == -1) break;
          
          // Check if we're inside an array
          int lastBracket = decodedJson.lastIndexOf("[", commaQuote);
          int lastCloseBracket = decodedJson.lastIndexOf("]", commaQuote);
          if (lastBracket > lastCloseBracket) {
              int valueStart = commaQuote + 2;
              int valueEnd = decodedJson.indexOf("\"", valueStart);
              if (valueEnd > valueStart) {
                  // Check if not already tracked
                  boolean isDuplicate = false;
                  for (int i = 0; i < stringPositions.size(); i++) {
                      int[] existingPos = (int[]) stringPositions.get(i);
                      if (existingPos[0] == valueStart) {
                          isDuplicate = true;
                          break;
                      }
                  }
                  if (!isDuplicate) {
                      String arrayValue = decodedJson.substring(valueStart, valueEnd);
                      stringPositions.add(new int[]{valueStart, valueEnd});
                      fieldNames.add("array_item");
                      fieldValues.add(arrayValue);
                  }
              }
          }
          pos = commaQuote + 2;
          continue;
      }
      
      int valueStart = bracketStart + 2;
      int valueEnd = decodedJson.indexOf("\"", valueStart);
      if (valueEnd > valueStart) {
          // Check if not already tracked
          boolean isDuplicate = false;
          for (int i = 0; i < stringPositions.size(); i++) {
              int[] existingPos = (int[]) stringPositions.get(i);
              if (existingPos[0] == valueStart) {
                  isDuplicate = true;
                  break;
              }
          }
          if (!isDuplicate) {
              String arrayValue = decodedJson.substring(valueStart, valueEnd);
              stringPositions.add(new int[]{valueStart, valueEnd});
              fieldNames.add("array_item");
              fieldValues.add(arrayValue);
          }
      }
      pos = bracketStart + 2;
  }
  
  logging().logToOutput("===========================================");
  logging().logToOutput("FOUND " + stringPositions.size() + " STRING FIELDS TO TEST");
  logging().logToOutput("===========================================");
  logging().logToOutput("");
  
  // List all fields that will be tested
  logging().logToOutput("Fields to be tested:");
  for (int i = 0; i < stringPositions.size(); i++) {
      String fn = (String) fieldNames.get(i);
      String fv = (String) fieldValues.get(i);
      logging().logToOutput("  [" + (i + 1) + "] " + fn + " = \"" + fv + "\"");
  }
  logging().logToOutput("");
  logging().logToOutput("===========================================");
  logging().logToOutput("STARTING INJECTION TESTS");
  logging().logToOutput("===========================================");
  logging().logToOutput("");
  
  int requestCount = 0;
  
  // Iterate through each string field and add a quote
  for (int i = 0; i < stringPositions.size(); i++) {
      int[] positions = (int[]) stringPositions.get(i);
      String fieldName = (String) fieldNames.get(i);
      String originalValue = (String) fieldValues.get(i);
      String injectedValue = originalValue + "'";
      
      // Create modified JSON with quote added to this field
      String modifiedJson = decodedJson.substring(0, positions[1]) + "'" + decodedJson.substring(positions[1]);
      
      // URL encode the modified JSON (preserve hackvertor tags if present)
      String encodedModifiedJson;
      if (hasHackvertor) {
          encodedModifiedJson = hackvertorPrefix + modifiedJson + hackvertorSuffix;
      } else {
          encodedModifiedJson = utilities().urlUtils().encode(modifiedJson);
      }
      
      // Rebuild the query string with modified JSON
      StringBuilder newQueryString = new StringBuilder();
      for (int j = 0; j < params.length; j++) {
          if (j > 0) newQueryString.append("&");
          if (j == targetParamIndex) {
              newQueryString.append(targetParamName).append("=").append(encodedModifiedJson);
          } else {
              newQueryString.append(params[j]);
          }
      }
      
      // Create new path with modified query
      String newPath = pathWithoutQuery + "?" + newQueryString.toString();
      
      // Create modified request
      var modifiedRequest = request.withPath(newPath);
      
      // Send the request
      requestCount++;
      logging().logToOutput("-------------------------------------------");
      logging().logToOutput("=== TEST " + requestCount + "/" + stringPositions.size() + " ===");
      logging().logToOutput("    Param          : " + targetParamName);
      logging().logToOutput("    Field          : " + fieldName);
      logging().logToOutput("    Original value : \"" + originalValue + "\"");
      logging().logToOutput("    Injected value : \"" + injectedValue + "\"");
      logging().logToOutput("    New path       : " + newPath);
      if (hasHackvertor) {
          logging().logToOutput("    Hackvertor     : detected; tags left unencoded");
      }
      
      try {
          var response = api().http().sendRequest(modifiedRequest, httpVersion);
          int statusCode = response.response().statusCode();
          int responseLength = response.response().body() == null ? 0 : response.response().body().length();
          String responseBody = response.response().bodyToString();
          if (responseBody == null) {
              responseBody = "";
          }
          
          logging().logToOutput("    HTTP Status    : " + statusCode);
          logging().logToOutput("    Response Length: " + responseLength + " bytes");
          
          // Show truncated response body (first 500 chars)
          String truncatedBody = responseBody;
          if (truncatedBody.length() > 500) {
              truncatedBody = truncatedBody.substring(0, 500) + "... [truncated]";
          }
          logging().logToOutput("    Response Body  :");
          logging().logToOutput("    " + truncatedBody.replace("\n", "\n    "));
          
          // Update response pane with this response
          httpEditor.responsePane().set(response.response().toByteArray());
          
      } catch (Exception e) {
          logging().logToOutput("    [ERROR] Request failed: " + e.getMessage());
      }
      
      logging().logToOutput("");
  }
  
  logging().logToOutput("===========================================");
  logging().logToOutput("COMPLETED: Tested " + requestCount + " string fields");
  logging().logToOutput("===========================================");
