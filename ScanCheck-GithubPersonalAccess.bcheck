metadata:
    language: v1-beta
    name: "GitHub Personal Access Token"
    description: "Detects GitHub personal access tokens in HTTP responses."
    author: "@puzzlepeaches"
    tags: "passive", "github", "token", "exposure" 

given response then
  if {latest.response} matches "\b(ghp_[a-zA-Z0-9]{36})\b" then
      report issue:
        severity: info 
        confidence: tentative
        detail: "GitHub Personal Access Token found in page."
        remediation: "Review and remove unnecessary exposure of keys and/or sensitive data from page source."
  end if