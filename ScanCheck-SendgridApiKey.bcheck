metadata:
  language: v1-beta
  name: "SendGrid API Key Exposure"
  description: "Looks for exposed SendGrid API keys."
  author: "@puzzlepeaches"
  tags: "passive", "exposure", "token", "sendgrid", "api-key" 

given response then
  if {latest.response} matches "SG\.[a-zA-Z0-9-_]{22}\.[a-zA-Z0-9_-]{43}" then
      report issue:
          severity: info
          confidence: tentative
          detail: "Sendgrid API key found in page."
          remediation: "Review and remove unnecessary exposure of keys and/or sensitive data from page source."
  end if