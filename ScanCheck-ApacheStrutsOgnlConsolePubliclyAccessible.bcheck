metadata:
    language: v1-beta
    name: "Apache Struts OGNL Console Publicly Accessible"
    description: "Detects publicly accessible Apache Struts OGNL Console which could be exploited to gain unauthorized access."
    author: "Sourav Kalal"
    tags: "active", "apache", "struts", "ognl", "exposure"

define:
    potential_path = "/struts/webconsole.html?debug=console"
       
given host then
    send request called check:
        method: "GET"
        path: {potential_path}
		
	if {check.response.status_code} is "200" and "title>OGNL Console" in {check.response.body} then
        report issue:
            severity: low
            confidence: firm
            detail: `Apache Struts OGNL Console found at {potential_path}.`
            remediation: "Restrict access to the struts console."
    end if
